# Copia in terraform.tfvars e compila con i valori del tuo ambiente.
# terraform.tfvars contiene solo la topologia (nessun segreto) ed è in
# .gitignore perché init-project.sh lo genera automaticamente.
# Le credenziali Proxmox vanno in terraform.auto.tfvars.

# ── Template (prodotto da Packer) ──────────────────────────────────────────────
# 9000=Rocky 9 | 9001=Ubuntu 22.04 | 9002=Ubuntu 24.04 | 9003=Debian 13
template_vm_id = 9002

# ── Nomi VM ────────────────────────────────────────────────────────────────────
master_name_prefix = "k8s-master"
worker_name_prefix = "k8s-worker"

# ── Rete ───────────────────────────────────────────────────────────────────────
network_bridge = "vmbr0"
k8s_subnet     = "192.168.1.0/24"
k8s_gateway    = "192.168.1.1"
dns_servers    = ["1.1.1.1", "8.8.8.8"]
domain         = "homelab.local"

# ── SSH ────────────────────────────────────────────────────────────────────────
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# ── Storage ────────────────────────────────────────────────────────────────────
storage_pool = "local-lvm"

# ── Control plane ──────────────────────────────────────────────────────────────
# 1 = setup minimal  |  3 = HA (richiede numero dispari per etcd quorum)
control_plane_count = 3
master_vm_id_start  = 44555
master_ip_start     = 210   # → 192.168.1.210, 192.168.1.211, ...
master_cpu_cores    = 4
master_memory       = 16384
master_disk_size    = 0     # 0 = eredita il disco dal template

# ── Worker ─────────────────────────────────────────────────────────────────────
worker_count       = 3
worker_vm_id_start = 44666
worker_ip_start    = 220   # → 192.168.1.220, 192.168.1.221, ...
worker_cpu_cores   = 4
worker_memory      = 16384
worker_disk_size   = 50
