# Credenziali Proxmox e configurazione rete — Copia in terraform.auto.tfvars
# terraform.auto.tfvars NON deve essere committato su git (contiene segreti).

# ── Connessione Proxmox ────────────────────────────────────
proxmox_url          = "https://192.168.1.10:8006/api2/json"
proxmox_token_id     = "automation@pve!terraform"
proxmox_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
proxmox_node         = "pve"

# ── Rete K3S (stessa subnet K8s) ──────────────────────────
k3s_subnet  = "192.168.1.0/24"
k3s_gateway = "192.168.1.1"

# ── SSH ────────────────────────────────────────────────────
ssh_public_key_path = "~/.ssh/id_rsa.pub"

# ── Storage ────────────────────────────────────────────────
storage_pool = "local-lvm"
