# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
.terraform.lock.hcl
terraform.auto.tfvars     # credenziali Proxmox (generato da init-project.sh)
terraform/terraform.auto.tfvars
*.tfstate
*.tfstate.backup
terraform/generated/      # inventory Kubespray generato da terraform apply
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Packer ────────────────────────────────────────────────────────────────────
packer.pkrvars.hcl              # contiene credenziali Proxmox
packer/packer.pkrvars.hcl       # path completo per chiarezza
packer_cache/
packer-manifest.json
packer/http/user-data           # generato da build.sh da ubuntu-user-data.tpl
packer/http/rocky-ks.cfg        # generato da build.sh da rocky-ks.cfg.tpl

# ── Backup / Temp ──────────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig

# ── Ansible ───────────────────────────────────────────────────────────────────
*.retry
.vault_pass
vault_pass.txt
group_vars/all.vault.yml

# ── Secrets / credenziali ──────────────────────────────────────────────────────
.env
*.secret
secrets/
credentials.json

# ── Chiavi SSH ────────────────────────────────────────────────────────────────
*.pem
id_rsa
id_ed25519
id_ecdsa

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ── Editor ────────────────────────────────────────────────────────────────────
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Log ───────────────────────────────────────────────────────────────────────
*.log
